# Copiar a .env y ajustar. El .env real nunca se commitea.
# Todas tienen valor por defecto: sin .env el compose levanta igual.

POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora
POSTGRES_DB=nexora

# Interfaz a la que se publican los puertos.
# 127.0.0.1 = solo esta maquina (por defecto, y lo correcto en desarrollo).
# 0.0.0.0   = accesible desde la red. Solo en un servidor detras de un proxy.
BIND_HOST=127.0.0.1

# Puertos en la maquina anfitriona.
DB_PORT=5432
API_PORT=3001
WEB_PORT=3000

# Puerto de la API dentro de la red del compose.
API_INTERNAL_PORT=3001

# Firma los tokens de sesion. NO se escribe aqui ningun valor: un secreto publicado
# en el repositorio deja de ser un secreto, y cualquiera podria firmar un token
# valido. `make env` genera uno aleatorio en el .env local.
JWT_SECRET=

# Cuanto dura una sesion, en segundos. Corta a proposito: cambiar de empresa
# reemite el token.
JWT_TTL_SECONDS=3600
