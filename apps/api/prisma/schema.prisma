// Nombres de tablas y columnas en snake_case, que es la convencion de PostgreSQL:
// asi el SQL crudo se lee natural. Los identificadores NO tienen valor por defecto en
// la base: los genera el dominio a traves del puerto IdGenerator.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships      Membership[]
  roles            Role[]
  codeSequences    CodeSequence[]
  categories       Category[]
  measurementUnits MeasurementUnit[]
  taxes            Tax[]
  warehouses       Warehouse[]
  items            Item[]
  adjustments      Adjustment[]
  adjustmentLines  AdjustmentLine[]
  movements        InventoryMovement[]
  stocks           ItemStock[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  purchaseLines    PurchaseOrderLine[]
  goodsReceipts    GoodsReceipt[]
  receiptLines     GoodsReceiptLine[]
  customers        Customer[]
  salesOrders      SalesOrder[]
  salesLines       SalesOrderLine[]
  dispatches       Dispatch[]
  dispatchLines    DispatchLine[]
  invoices         Invoice[]
  invoiceLines     InvoiceLine[]
  payments         CustomerPayment[]
  allocations      PaymentAllocation[]
  profile          CompanyProfile?
  settings         CompanySettings?
  exchangeRates    ExchangeRate[]

  @@map("tenants")
}

/// Una persona: una cuenta, un correo unico global. NO lleva tenantId — lo que la ata
/// a una empresa es una membresia.
model User {
  id           String   @id @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("users")
}

/// Vincula una persona con una empresa. Los roles se asignan AQUI, no al usuario:
/// se puede ser administrador en una empresa y solo lectura en otra.
model Membership {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

/// Los roles son POR EMPRESA: cada una agrupa permisos como quiera.
/// `grantsAll` concede todos los permisos DENTRO de su empresa, sin saltar el
/// aislamiento. Evita tener que actualizar una lista cada vez que nace un permiso.
model Role {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  grantsAll Boolean  @default(false) @map("grants_all")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

/// Catalogo global. El CODIGO es la identidad: unico, estable y legible.
/// Declarar un permiso nuevo es insertar una fila, sin buscar identificadores.
model Permission {
  code        String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

// ---------------------------------------------------------------- empresa
//
// Quien es la empresa y como trabaja. Una fila por empresa en cada tabla, que se escribe la primera
// vez que se guarda: hasta entonces valen los valores por defecto del dominio.

/// Monedas que existen: catalogo global, igual para todas las empresas. Llegan con las migraciones.
model Currency {
  code      String  @id @db.Char(3)
  name      String  @db.VarChar(60)
  symbol    String  @db.VarChar(8)
  decimals  Int     @default(2)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  baseOf                 CompanySettings[] @relation("BaseCurrency")
  secondaryOf            CompanySettings[] @relation("SecondaryCurrency")
  rates                  ExchangeRate[]
  purchaseOrders         PurchaseOrder[]   @relation("PurchaseOrderCurrency")
  goodsReceipts          GoodsReceipt[]    @relation("GoodsReceiptCurrency")
  salesOrders            SalesOrder[]      @relation("SalesOrderCurrency")
  invoices               Invoice[]         @relation("InvoiceCurrency")
  customerPayments       CustomerPayment[] @relation("CustomerPaymentCurrency")
  purchaseOrdersAsBase   PurchaseOrder[]   @relation("PurchaseOrderBaseCurrency")
  goodsReceiptsAsBase    GoodsReceipt[]    @relation("GoodsReceiptBaseCurrency")
  salesOrdersAsBase      SalesOrder[]      @relation("SalesOrderBaseCurrency")
  invoicesAsBase         Invoice[]         @relation("InvoiceBaseCurrency")
  customerPaymentsAsBase CustomerPayment[] @relation("CustomerPaymentBaseCurrency")

  @@map("currencies")
}

/// Los datos que la empresa pone en sus documentos.
model CompanyProfile {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  legalName String   @map("legal_name") @db.VarChar(150)
  tradeName String?  @map("trade_name") @db.VarChar(150)
  fiscalId  String?  @map("fiscal_id") @db.VarChar(30)
  address   String?  @db.VarChar(300)
  phone     String?  @db.VarChar(40)
  email     String?  @db.VarChar(150)
  updatedAt DateTime @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

/// Moneda principal y secundaria, zona horaria y decimales. Los rangos de decimales los repite un
/// CHECK en la migracion.
model CompanySettings {
  tenantId           String           @id @map("tenant_id") @db.Uuid
  baseCurrency       String           @map("base_currency") @db.Char(3)
  secondaryCurrency  String?          @map("secondary_currency") @db.Char(3)
  timeZone           String           @map("time_zone") @db.VarChar(64)
  amountDecimals     Int              @map("amount_decimals")
  priceDecimals      Int              @map("price_decimals")
  rateType           ExchangeRateType @default(legal) @map("rate_type")
  allowsRateOverride Boolean          @default(true) @map("allows_rate_override")
  updatedAt          DateTime         @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  base      Currency  @relation("BaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  secondary Currency? @relation("SecondaryCurrency", fields: [secondaryCurrency], references: [code], onDelete: Restrict)

  @@map("company_settings")
}

// Legal: la oficial del BCV. Manual: una interna de la empresa. Series independientes.
enum ExchangeRateType {
  legal
  manual
}

// Bolivares por 1 unidad de la moneda, por empresa, fecha y tipo. El bolivar no lleva tasa.
model ExchangeRate {
  id        String           @id @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  currency  String           @db.Char(3)
  rateDate  DateTime         @map("rate_date") @db.Date
  type      ExchangeRateType
  rate      Decimal          @db.Decimal(18, 8)
  source    String?          @db.VarChar(150)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @map("created_at")
  updatedAt DateTime         @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currencyInfo Currency @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, currency, type, rateDate])
  @@index([tenantId, rateDate])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------- catalogo
//
// Nada se borra: los maestros se desactivan con `is_active`. Por eso las claves
// ajenas entre maestros son RESTRICT: una fila referenciada no puede desaparecer.
// Contra `tenants` siguen en CASCADE, como el resto del esquema.

/// Contador del codigo legible por empresa y prefijo (`ART000001`). Una fila por
/// pareja: el incremento es un UPDATE atomico, asi dos altas simultaneas nunca
/// reciben el mismo numero.
model CodeSequence {
  tenantId  String @map("tenant_id") @db.Uuid
  prefix    String @db.VarChar(3)
  lastValue Int    @default(0) @map("last_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, prefix])
  @@map("code_sequences")
}

/// Clasificacion de los articulos. Un solo nivel, sin jerarquia.
model Category {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(12)
  name        String   @db.VarChar(150)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  Item[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("categories")
}

/// Unidad, Caja, Kilogramo. NO guarda factores de conversion: el contenido de una
/// caja cambia de articulo en articulo, asi que la equivalencia vive en `item_units`.
model MeasurementUnit {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  code         String   @db.VarChar(12)
  name         String   @db.VarChar(100)
  abbreviation String   @db.VarChar(10)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemUnits       ItemUnit[]
  adjustmentLines AdjustmentLine[]
  purchaseLines   PurchaseOrderLine[]
  receiptLines    GoodsReceiptLine[]
  salesLines      SalesOrderLine[]
  dispatchLines   DispatchLine[]
  invoiceLines    InvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@unique([tenantId, abbreviation])
  @@map("measurement_units")
}

/// Impuesto aplicable a un articulo. El porcentaje se copiara a la linea del documento
/// al confirmarlo: cambiarlo aqui no altera lo ya emitido.
model Tax {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(12)
  name      String   @db.VarChar(100)
  rate      Decimal  @db.Decimal(7, 4)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  soldItems     Item[] @relation("SalesTax")
  purchasedItems Item[] @relation("PurchaseTax")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("taxes")
}

/// Lugar donde se guarda inventario. Una sola bodega por defecto por empresa: lo garantiza
/// un indice unico parcial que Prisma no sabe expresar y vive en la migracion.
model Warehouse {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(12)
  name      String   @db.VarChar(150)
  address   String?  @db.VarChar(500)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adjustments    Adjustment[]
  movements      InventoryMovement[]
  stocks         ItemStock[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  salesOrders    SalesOrder[]
  dispatches     Dispatch[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("warehouses")
}

/// El maestro de productos y servicios. `sku` lo escribe la persona; `code` es el
/// correlativo del sistema.
model Item {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(12)
  sku           String   @db.VarChar(60)
  /// El que trae impreso el producto; opcional y unico por empresa.
  barcode       String?  @db.VarChar(60)
  name          String   @db.VarChar(200)
  description   String?
  type          ItemType
  isPurchasable Boolean  @default(true) @map("is_purchasable")
  isSellable    Boolean  @default(true) @map("is_sellable")
  categoryId    String?  @map("category_id") @db.Uuid
  /// Se copia a la linea al venderlo; puede ser distinto del de compra o faltar.
  salesTaxId    String?  @map("sales_tax_id") @db.Uuid
  purchaseTaxId String?  @map("purchase_tax_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Compuestas con la empresa: ni la propia base acepta un articulo que apunte a la
  // categoria o al impuesto de otra empresa.
  category        Category?           @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  salesTax        Tax?                @relation("SalesTax", fields: [tenantId, salesTaxId], references: [tenantId, id], onDelete: Restrict)
  purchaseTax     Tax?                @relation("PurchaseTax", fields: [tenantId, purchaseTaxId], references: [tenantId, id], onDelete: Restrict)
  units           ItemUnit[]
  adjustmentLines AdjustmentLine[]
  movements       InventoryMovement[]
  stocks          ItemStock[]
  purchaseLines   PurchaseOrderLine[]
  receiptLines    GoodsReceiptLine[]
  salesLines      SalesOrderLine[]
  dispatchLines   DispatchLine[]
  invoiceLines    InvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@index([tenantId, salesTaxId])
  @@index([tenantId, purchaseTaxId])
  @@map("items")
}

/// `inventoried` mueve existencia; `service` se compra y se vende pero nunca tiene stock.
enum ItemType {
  inventoried
  service

  @@map("item_type")
}

/// Las unidades en que se maneja un articulo. Exactamente una es la base (factor 1)
/// y en ella se guardara todo el stock; el resto dice cuantas bases contiene. Que no haya
/// dos bases lo garantiza un indice unico parcial que vive en la migracion.
model ItemUnit {
  tenantId         String  @map("tenant_id") @db.Uuid
  itemId           String  @map("item_id") @db.Uuid
  unitId           String  @map("unit_id") @db.Uuid
  conversionFactor Decimal @map("conversion_factor") @db.Decimal(18, 8)
  isBase           Boolean @map("is_base")

  item Item            @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)
  unit MeasurementUnit @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)

  @@id([itemId, unitId])
  @@index([tenantId, unitId])
  @@map("item_units")
}

// ---------------------------------------------------------------- inventario
//
// Solo el ajuste mueve existencia en el H3; entradas y despachos llegaran con compras y
// ventas. El kardex nunca se edita ni se borra: un error se corrige con un movimiento
// de contrapartida. Las existencias son derivadas y siempre cuadran con el kardex.

/// Documento que corrige la existencia de una bodega: conteos, mermas, hallazgos.
model Adjustment {
  id             String           @id @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  code           String           @db.VarChar(12)
  warehouseId    String           @map("warehouse_id") @db.Uuid
  adjustmentDate DateTime         @map("adjustment_date") @db.Date
  notes          String?          @db.VarChar(500)
  status         AdjustmentStatus @default(draft)
  confirmedAt    DateTime?        @map("confirmed_at")
  cancelledAt    DateTime?        @map("cancelled_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse        @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  lines     AdjustmentLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("adjustments")
}

/// Borrador editable, confirmado (ya movio existencia) o anulado (revertido con
/// contrapartida, o descartado si era borrador).
enum AdjustmentStatus {
  draft
  confirmed
  cancelled

  @@map("adjustment_status")
}

enum StockDirection {
  in
  out

  @@map("stock_direction")
}

/// Una linea del ajuste. `quantity` en la unidad elegida; `base_quantity` ya convertida a
/// la unidad base del articulo, que es en la que se guarda el stock.
model AdjustmentLine {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  adjustmentId String         @map("adjustment_id") @db.Uuid
  lineNumber   Int            @map("line_number")
  itemId       String         @map("item_id") @db.Uuid
  unitId       String         @map("unit_id") @db.Uuid
  direction    StockDirection
  quantity     Decimal        @db.Decimal(18, 4)
  baseQuantity Decimal        @map("base_quantity") @db.Decimal(18, 4)
  unitCost     Decimal?       @map("unit_cost") @db.Decimal(18, 6)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adjustment Adjustment      @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Cascade)
  item       Item            @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  unit       MeasurementUnit @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([adjustmentId, lineNumber])
  @@index([tenantId, itemId])
  @@map("adjustment_lines")
}

/// El kardex: una fila por cada cambio de existencia, inmutable. `sequence` ordena los
/// movimientos de un articulo en una bodega sin depender de la hora; `balance_*` es el
/// saldo despues del movimiento, para auditar sin recalcular.
model InventoryMovement {
  id                 String         @id @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  itemId             String         @map("item_id") @db.Uuid
  warehouseId        String         @map("warehouse_id") @db.Uuid
  sequence           Int
  direction          StockDirection
  quantity           Decimal        @db.Decimal(18, 4)
  unitCost           Decimal        @map("unit_cost") @db.Decimal(18, 6)
  balanceQuantity    Decimal        @map("balance_quantity") @db.Decimal(18, 4)
  balanceAverageCost Decimal        @map("balance_average_cost") @db.Decimal(18, 6)
  originType         String         @map("origin_type") @db.VarChar(20)
  originId           String         @map("origin_id") @db.Uuid
  originLineId       String?        @map("origin_line_id") @db.Uuid
  reversalOfId       String?        @map("reversal_of_id") @db.Uuid
  occurredAt         DateTime       @map("occurred_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item       Item               @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  warehouse  Warehouse          @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  reversalOf InventoryMovement? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy InventoryMovement? @relation("Reversal")

  @@unique([tenantId, itemId, warehouseId, sequence])
  // Un movimiento se revierte una sola vez: anular dos veces no puede duplicar la contrapartida.
  @@unique([reversalOfId])
  @@index([tenantId, originType, originId])
  @@map("inventory_movements")
}

/// Existencia actual de un articulo en una bodega, en su unidad base. Derivada: solo la
/// escribe quien escribe el kardex, en la misma transaccion.
model ItemStock {
  tenantId     String   @map("tenant_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  quantity     Decimal  @default(0) @db.Decimal(18, 4)
  averageCost  Decimal  @default(0) @map("average_cost") @db.Decimal(18, 6)
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, itemId, warehouseId])
  @@index([tenantId, warehouseId])
  @@map("item_stocks")
}

// ---------------------------------------------------------------- compras
//
// Proveedor, orden de compra y entrada de mercancia. La orden no mueve existencia: anuncia
// lo que viene en camino. La entrada confirmada es la que la mueve, y lo hace a traves del
// inventario, que sigue siendo el unico que escribe kardex y existencias.

/// A quien se le compra. Nunca se borra: se desactiva.
model Supplier {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String   @db.VarChar(12)
  name            String   @db.VarChar(150)
  fiscalId        String?  @map("fiscal_id") @db.VarChar(30)
  email           String?  @db.VarChar(150)
  phone           String?  @db.VarChar(40)
  address         String?  @db.VarChar(500)
  paymentTermDays Int      @default(0) @map("payment_term_days")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders PurchaseOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("suppliers")
}

/// Borrador editable, confirmada (anuncia mercancia en camino), recibida en parte,
/// recibida del todo o anulada.
enum PurchaseOrderStatus {
  draft
  confirmed
  partially_received
  received
  cancelled

  @@map("purchase_order_status")
}

/// Lo que se le pide a un proveedor para una bodega.
model PurchaseOrder {
  id                 String              @id @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  code               String              @db.VarChar(12)
  supplierId         String              @map("supplier_id") @db.Uuid
  warehouseId        String              @map("warehouse_id") @db.Uuid
  orderDate          DateTime            @map("order_date") @db.Date
  expectedDate       DateTime?           @map("expected_date") @db.Date
  notes              String?             @db.VarChar(500)
  currency           String              @db.Char(3)
  exchangeRate       Decimal?            @map("exchange_rate") @db.Decimal(18, 8)
  baseCurrency       String              @map("base_currency") @db.Char(3)
  baseExchangeRate   Decimal?            @map("base_exchange_rate") @db.Decimal(18, 8)
  manualExchangeRate Boolean             @default(false) @map("manual_exchange_rate")
  status             PurchaseOrderStatus @default(draft)
  confirmedAt        DateTime?           @map("confirmed_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currencyInfo     Currency            @relation("PurchaseOrderCurrency", fields: [currency], references: [code], onDelete: Restrict)
  baseCurrencyInfo Currency            @relation("PurchaseOrderBaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  supplier         Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  warehouse        Warehouse           @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  lines            PurchaseOrderLine[]
  receipts         GoodsReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

/// Una linea de la orden. `unit_cost` es por unidad de la linea y `tax_rate` es el
/// porcentaje del impuesto del articulo cuando se escribio. `received_quantity`, en la
/// unidad de la linea, lo suman las entradas confirmadas y lo restan las anuladas.
model PurchaseOrderLine {
  id               String  @id @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  lineNumber       Int     @map("line_number")
  itemId           String  @map("item_id") @db.Uuid
  unitId           String  @map("unit_id") @db.Uuid
  quantity         Decimal @db.Decimal(18, 4)
  baseQuantity     Decimal @map("base_quantity") @db.Decimal(18, 4)
  unitCost         Decimal @map("unit_cost") @db.Decimal(18, 6)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18, 4)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        PurchaseOrder      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  item         Item               @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  unit         MeasurementUnit    @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)
  receiptLines GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@unique([orderId, lineNumber])
  @@index([tenantId, itemId])
  @@map("purchase_order_lines")
}

enum GoodsReceiptStatus {
  draft
  confirmed
  cancelled

  @@map("goods_receipt_status")
}

/// Lo que llego de una orden. Al confirmarse sube la existencia; al anularse la revierte.
model GoodsReceipt {
  id                 String             @id @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  code               String             @db.VarChar(12)
  orderId            String             @map("order_id") @db.Uuid
  warehouseId        String             @map("warehouse_id") @db.Uuid
  receiptDate        DateTime           @map("receipt_date") @db.Date
  notes              String?            @db.VarChar(500)
  currency           String             @db.Char(3)
  exchangeRate       Decimal?           @map("exchange_rate") @db.Decimal(18, 8)
  baseCurrency       String             @map("base_currency") @db.Char(3)
  baseExchangeRate   Decimal?           @map("base_exchange_rate") @db.Decimal(18, 8)
  manualExchangeRate Boolean            @default(false) @map("manual_exchange_rate")
  status             GoodsReceiptStatus @default(draft)
  confirmedAt        DateTime?          @map("confirmed_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currencyInfo     Currency           @relation("GoodsReceiptCurrency", fields: [currency], references: [code], onDelete: Restrict)
  baseCurrencyInfo Currency           @relation("GoodsReceiptBaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  order            PurchaseOrder      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  warehouse        Warehouse          @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  lines            GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("goods_receipts")
}

/// Una linea de la entrada: cuanto llego de una linea de la orden, en su misma unidad.
model GoodsReceiptLine {
  id           String  @id @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  receiptId    String  @map("receipt_id") @db.Uuid
  lineNumber   Int     @map("line_number")
  orderLineId  String  @map("order_line_id") @db.Uuid
  itemId       String  @map("item_id") @db.Uuid
  unitId       String  @map("unit_id") @db.Uuid
  quantity     Decimal @db.Decimal(18, 4)
  baseQuantity Decimal @map("base_quantity") @db.Decimal(18, 4)
  unitCost     Decimal @map("unit_cost") @db.Decimal(18, 6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt   GoodsReceipt      @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: Restrict)
  item      Item              @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  unit      MeasurementUnit   @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([receiptId, lineNumber])
  // Una linea de la orden aparece una sola vez en cada entrada.
  @@unique([receiptId, orderLineId])
  @@index([tenantId, orderLineId])
  @@map("goods_receipt_lines")
}

// ---------------------------------------------------------------- ventas
//
// Cliente, pedido, despacho y factura. El pedido confirmado reserva existencia sin moverla; el
// despacho confirmado la saca a traves del inventario; la factura cobra lo despachado y no toca
// existencia.

/// A quien se le vende. Nunca se borra: se desactiva.
model Customer {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String   @db.VarChar(12)
  name            String   @db.VarChar(150)
  fiscalId        String?  @map("fiscal_id") @db.VarChar(30)
  email           String?  @db.VarChar(150)
  phone           String?  @db.VarChar(40)
  address         String?  @db.VarChar(500)
  paymentTermDays Int      @default(0) @map("payment_term_days")
  creditLimit     Decimal? @map("credit_limit") @db.Decimal(18, 4)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders   SalesOrder[]
  invoices Invoice[]
  payments CustomerPayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("customers")
}

/// Borrador, confirmado (reserva existencia), despachado en parte, despachado o anulado.
enum SalesOrderStatus {
  draft
  confirmed
  partially_dispatched
  dispatched
  cancelled

  @@map("sales_order_status")
}

model SalesOrder {
  id                 String           @id @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  code               String           @db.VarChar(12)
  customerId         String           @map("customer_id") @db.Uuid
  warehouseId        String           @map("warehouse_id") @db.Uuid
  orderDate          DateTime         @map("order_date") @db.Date
  notes              String?          @db.VarChar(500)
  status             SalesOrderStatus @default(draft)
  confirmedAt        DateTime?        @map("confirmed_at")
  cancelledAt        DateTime?        @map("cancelled_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  currency           String           @db.Char(3)
  exchangeRate       Decimal?         @map("exchange_rate") @db.Decimal(18, 8)
  baseCurrency       String           @map("base_currency") @db.Char(3)
  baseExchangeRate   Decimal?         @map("base_exchange_rate") @db.Decimal(18, 8)
  manualExchangeRate Boolean          @default(false) @map("manual_exchange_rate")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currencyInfo     Currency         @relation("SalesOrderCurrency", fields: [currency], references: [code], onDelete: Restrict)
  baseCurrencyInfo Currency         @relation("SalesOrderBaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  customer         Customer         @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  warehouse        Warehouse        @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  lines            SalesOrderLine[]
  dispatches       Dispatch[]
  invoices         Invoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("sales_orders")
}

/// Una linea del pedido. `unit_price` es por unidad de la linea, sin impuesto; `tax_rate` se copia
/// del articulo. Lo pendiente de despachar de un pedido confirmado es lo que reserva.
model SalesOrderLine {
  id                 String  @id @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  orderId            String  @map("order_id") @db.Uuid
  lineNumber         Int     @map("line_number")
  itemId             String  @map("item_id") @db.Uuid
  unitId             String  @map("unit_id") @db.Uuid
  quantity           Decimal @db.Decimal(18, 4)
  baseQuantity       Decimal @map("base_quantity") @db.Decimal(18, 4)
  unitPrice          Decimal @map("unit_price") @db.Decimal(18, 6)
  taxRate            Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  dispatchedQuantity Decimal @default(0) @map("dispatched_quantity") @db.Decimal(18, 4)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         SalesOrder      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  item          Item            @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  unit          MeasurementUnit @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)
  dispatchLines DispatchLine[]

  @@unique([tenantId, id])
  @@unique([orderId, lineNumber])
  @@index([tenantId, itemId])
  @@map("sales_order_lines")
}

enum DispatchStatus {
  draft
  confirmed
  cancelled

  @@map("dispatch_status")
}

/// Lo que salio de un pedido. Al confirmarse baja la existencia; al anularse la devuelve.
model Dispatch {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  code         String         @db.VarChar(12)
  orderId      String         @map("order_id") @db.Uuid
  warehouseId  String         @map("warehouse_id") @db.Uuid
  dispatchDate DateTime       @map("dispatch_date") @db.Date
  notes        String?        @db.VarChar(500)
  status       DispatchStatus @default(draft)
  confirmedAt  DateTime?      @map("confirmed_at")
  cancelledAt  DateTime?      @map("cancelled_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     SalesOrder     @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  lines     DispatchLine[]
  invoices  Invoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("dispatches")
}

model DispatchLine {
  id           String  @id @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  dispatchId   String  @map("dispatch_id") @db.Uuid
  lineNumber   Int     @map("line_number")
  orderLineId  String  @map("order_line_id") @db.Uuid
  itemId       String  @map("item_id") @db.Uuid
  unitId       String  @map("unit_id") @db.Uuid
  quantity     Decimal @db.Decimal(18, 4)
  baseQuantity Decimal @map("base_quantity") @db.Decimal(18, 4)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatch  Dispatch        @relation(fields: [tenantId, dispatchId], references: [tenantId, id], onDelete: Cascade)
  orderLine SalesOrderLine  @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: Restrict)
  item      Item            @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  unit      MeasurementUnit @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([dispatchId, lineNumber])
  @@unique([dispatchId, orderLineId])
  @@index([tenantId, orderLineId])
  @@map("dispatch_lines")
}

enum InvoiceStatus {
  issued
  cancelled

  @@map("invoice_status")
}

/// La factura de un despacho. Sus importes se guardan: un documento fiscal no cambia porque
/// cambie un precio. Solo una emitida por despacho (indice parcial en la migracion).
model Invoice {
  id                 String        @id @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  code               String        @db.VarChar(12)
  dispatchId         String        @map("dispatch_id") @db.Uuid
  orderId            String        @map("order_id") @db.Uuid
  customerId         String        @map("customer_id") @db.Uuid
  issueDate          DateTime      @map("issue_date") @db.Date
  dueDate            DateTime      @map("due_date") @db.Date
  notes              String?       @db.VarChar(500)
  status             InvoiceStatus @default(issued)
  subtotal           Decimal       @db.Decimal(18, 4)
  tax                Decimal       @db.Decimal(18, 4)
  total              Decimal       @db.Decimal(18, 4)
  cancelledAt        DateTime?     @map("cancelled_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  currency           String        @db.Char(3)
  exchangeRate       Decimal?      @map("exchange_rate") @db.Decimal(18, 8)
  baseCurrency       String        @map("base_currency") @db.Char(3)
  baseExchangeRate   Decimal?      @map("base_exchange_rate") @db.Decimal(18, 8)
  manualExchangeRate Boolean       @default(false) @map("manual_exchange_rate")
  subtotalVes        Decimal?      @map("subtotal_ves") @db.Decimal(18, 4)
  taxVes             Decimal?      @map("tax_ves") @db.Decimal(18, 4)
  totalVes           Decimal?      @map("total_ves") @db.Decimal(18, 4)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currencyInfo     Currency            @relation("InvoiceCurrency", fields: [currency], references: [code], onDelete: Restrict)
  baseCurrencyInfo Currency            @relation("InvoiceBaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  dispatch         Dispatch            @relation(fields: [tenantId, dispatchId], references: [tenantId, id], onDelete: Restrict)
  order            SalesOrder          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  customer         Customer            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  lines            InvoiceLine[]
  allocations      PaymentAllocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, dispatchId])
  @@index([tenantId, customerId])
  @@map("invoices")
}

model InvoiceLine {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  invoiceId  String  @map("invoice_id") @db.Uuid
  lineNumber Int     @map("line_number")
  itemId     String  @map("item_id") @db.Uuid
  unitId     String  @map("unit_id") @db.Uuid
  quantity   Decimal @db.Decimal(18, 4)
  unitPrice  Decimal @map("unit_price") @db.Decimal(18, 6)
  taxRate    Decimal @map("tax_rate") @db.Decimal(7, 4)
  subtotal   Decimal @db.Decimal(18, 4)
  tax        Decimal @db.Decimal(18, 4)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice         @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)
  item    Item            @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  unit    MeasurementUnit @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([invoiceId, lineNumber])
  @@map("invoice_lines")
}

// ---------------------------------------------------------------- cuentas por cobrar

/// Borrador, confirmado (baja el saldo de sus facturas) o anulado.
enum PaymentStatus {
  draft
  confirmed
  cancelled

  @@map("payment_status")
}

enum PaymentMethod {
  cash
  transfer
  card
  check

  @@map("payment_method")
}

/// Un cobro de un cliente, repartido entre sus facturas emitidas.
model CustomerPayment {
  id                 String        @id @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  code               String        @db.VarChar(12)
  customerId         String        @map("customer_id") @db.Uuid
  paymentDate        DateTime      @map("payment_date") @db.Date
  method             PaymentMethod
  reference          String?       @db.VarChar(100)
  notes              String?       @db.VarChar(500)
  amount             Decimal       @db.Decimal(18, 4)
  status             PaymentStatus @default(draft)
  confirmedAt        DateTime?     @map("confirmed_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  currency           String        @db.Char(3)
  exchangeRate       Decimal?      @map("exchange_rate") @db.Decimal(18, 8)
  baseCurrency       String        @map("base_currency") @db.Char(3)
  baseExchangeRate   Decimal?      @map("base_exchange_rate") @db.Decimal(18, 8)
  manualExchangeRate Boolean       @default(false) @map("manual_exchange_rate")
  amountVes          Decimal?      @map("amount_ves") @db.Decimal(18, 4)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currencyInfo     Currency            @relation("CustomerPaymentCurrency", fields: [currency], references: [code], onDelete: Restrict)
  baseCurrencyInfo Currency            @relation("CustomerPaymentBaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  customer         Customer            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  allocations      PaymentAllocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("customer_payments")
}

/// Cuanto de un cobro va a una factura.
model PaymentAllocation {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  paymentId          String   @map("payment_id") @db.Uuid
  invoiceId          String   @map("invoice_id") @db.Uuid
  amount             Decimal  @db.Decimal(18, 4)
  // Bolivares por 1 unidad de la moneda de la factura el dia del cobro.
  exchangeRate       Decimal? @map("exchange_rate") @db.Decimal(18, 8)
  // En bolivares; null en las facturas anteriores a las tasas.
  exchangeDifference Decimal? @map("exchange_difference") @db.Decimal(18, 4)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment CustomerPayment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Cascade)
  invoice Invoice         @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([paymentId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("payment_allocations")
}
